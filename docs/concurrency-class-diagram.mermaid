%% v4.0.0 并发模型类图：单旋钮（aiMaxConcurrency 1–99）+ 滑动窗口调度。
%% 旧的双参数（aiConcurrency / aiConcurrencyLimit）与 resolveSchedule 已移除。
classDiagram
    direction TB

    class AiConcurrency {
        <<service · 纯函数 · 唯一权威>>
        +AI_MAX_CONCURRENCY_MIN = 1
        +AI_MAX_CONCURRENCY_MAX = 99
        +DEFAULT_AI_MAX_CONCURRENCY = 3
        +clampMaxConcurrency(raw, fallback) number
        +validateMaxConcurrency(raw) string|null
        +normalizeMaxConcurrency(saved) MaxConcurrencyMigration
    }

    class MaxConcurrencyMigration {
        <<interface>>
        +value number
        +adjusted boolean
        +legacy concurrency?/limit?
    }

    class AiScheduler {
        <<service · 滑动窗口>>
        +runSlidingWindow(tasks, options) SlideResult[]
        +slidePhaseText(progress, n) string
        +startGapOf(n, intervalMs) number
        +clampMaxConcurrency(raw, fallback) number
    }

    class SlideOptions {
        <<interface>>
        +maxConcurrency number
        +startIntervalMs? number
        +retry? number
        +signal? AbortSignal
        +onStart?/onSettled?/onProgress?
    }

    class SlideTask {
        <<interface>>
        +key string
        +label string
        +run(signal) Promise
    }

    class SlideResult {
        <<interface>>
        +key/label string
        +ok boolean
        +value? T
        +error? string
        +attempts number
        +startedAt/endedAt number
    }

    class SlideProgress {
        <<interface>>
        +done/total number
        +inFlight/queued number
        +current string
    }

    class AiReadingRunner {
        <<service · 执行计划>>
        +runReadingPlan(options) FullReport
        +fusionExcerptChars(entry) number
        +buildFusionExcerpts(entry, sections, skipped) string
        +splitFusionSummary(raw) FusionSplit
    }

    class AiReadingPlan {
        <<service · 纯函数>>
        +planReading(req) ReadingPlan
        +requestCountOf(plan) number
        +normalizeDims(dims) ReadingDimKey[]
        +normalizeSelection(pick) SelectionPick|null
    }

    class ReadingPlan {
        <<interface>>
        +entry/detail
        +singleShot boolean
        +tasks ReadingTask[]
        +fusion ReadingTask|null
        +title string
    }

    class ReadingProgress {
        <<interface>>
        +done/total number
        +current/phase string
        +elapsedMs number
        +etaMs number|null
        +skipped/failed string[]
        +inFlight number
        +maxConcurrency number
    }

    AiConcurrency ..> MaxConcurrencyMigration : 产出
    AiScheduler ..> AiConcurrency : 复用归一（不重复实现）
    AiScheduler --> SlideOptions : 入参
    AiScheduler --> SlideTask : 调度对象
    AiScheduler --> SlideResult : 产出（按任务原始顺序）
    AiScheduler --> SlideProgress : 回调载荷
    AiReadingRunner --> AiScheduler : 多请求档
    AiReadingRunner --> ReadingProgress : 进度
    AiReadingRunner ..> AiReadingPlan : 消费计划
    AiReadingPlan ..> ReadingPlan : 产出

    note for AiScheduler "起速按「已启动数 ≥ N」判定；落定即补；N=1 时 gap=0；重试复用同一并发槽；取消后不再启动新任务；定时器零残留"
    note for AiConcurrency "旧 aiConcurrency / aiConcurrencyLimit 只作为迁移输入；新字段优先，limit 永不作为来源"
